# Shared across every club in this checkout.
# Club-specific secrets go in .env.<slug>, which overrides this file, and in
# production come from that club's own Netlify site settings.

# Which club to run: reads clubs/<slug>/config.json.
# Override per command with:  npm start -- --club <slug>
CLUB=vttc

# --- per club (put these in .env.<slug>) ---------------------------------
# MONGODB_URI=mongodb+srv://.../<db>?retryWrites=true
# MONGODB_DB=            # optional: overrides the dev/prod auto-suffix
# CLUB_TIMEZONE=         # optional: overrides the club config's timezone
# PUSHER_APP_ID=
# PUSHER_SECRET=
# VITE_PUSHER_KEY=
# VITE_PUSHER_CLUSTER=
# VITE_PROD_HOST=
# ADMIN_PASSWORD=
# TABLET_PASSWORD=
# SUPER_ADMIN_HASH=
# SUPER_ADMIN_SALT=
